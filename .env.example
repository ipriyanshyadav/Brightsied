# Copy to .env (or .env.local) for development; set the same keys in Vercel for production.

# Canonical origin, no trailing slash. Optional: defaults to the URL in content/seed/site.ts.
NEXT_PUBLIC_SITE_URL=

# Lead forms (project brief, demo requests), delivered through Resend (https://resend.com).
RESEND_API_KEY=
# Inbox that receives new leads.
LEAD_INBOX_EMAIL=
# Sender. Until a domain is verified in Resend, use: Brightera <onboarding@resend.dev>
LEAD_FROM_EMAIL=
# "true" sends visitors a confirmation email. Needs a verified sending domain.
LEAD_SEND_AUTOREPLY=false

# Content (Sanity, https://www.sanity.io). Leave the project id empty to use content/seed/.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only for a private dataset.
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate (16+ characters).
SANITY_REVALIDATE_SECRET=

# Personal Sanity token for the CLI only (npm run cms:seed); alternative to `npx sanity login`.
# The site never reads it. Never add it to Vercel.
SANITY_AUTH_TOKEN=
